# Repo-relative paths. Copy to paths.env if you need overrides.

export DUMOE_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export DUMOE_DATA="${DUMOE_ROOT}/dataset"

export SAMPLES_CSV="${DUMOE_DATA}/ids/windows.csv"
export TWEET_EMB_SHARDS_DIR="${DUMOE_DATA}/local/embeddings_pt"
export USER_PROFILE_PT="${DUMOE_DATA}/local/user_profile.pt"
export SAMPLES_DIR="${DUMOE_DATA}/local/message_user_samples"
export LABELS_CACHE="${DUMOE_DATA}/local/labels_cache.json"
export USER_TWEET_IDS_MAP="${DUMOE_DATA}/local/user_tweet_ids_map.pt"
export LABEL_USER_DIRS=""

export OUTPUT_ROOT="${DUMOE_ROOT}/outputs"
export PREPROCESS_CACHE_DIR="${DUMOE_ROOT}/cache"

# Repo root first so `import downstream...` and `import dumoe...` work.
export PYTHONPATH="${DUMOE_ROOT}:${DUMOE_ROOT}/dumoe:${DUMOE_ROOT}/baselines:${DUMOE_ROOT}/baselines/project:${PYTHONPATH:-}"
